---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: mobile-agent-web
  name: mobile-agent-web
  namespace: abiapay
spec:
  replicas: 2
  selector:
    matchLabels:
      app: mobile-agent-web
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: mobile-agent-web
    spec:
      containers:
        - image: $CONTAINER_IMAGE
          name: mobile-agent-web
          ports:
            - containerPort: 3000
              protocol: TCP
          resources: {}
      restartPolicy: Always
      imagePullSecrets:
        - name: regcred
