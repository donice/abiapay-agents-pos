---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: pos-portal
  name: pos-portal
  namespace: abiapay
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pos-portal
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: pos-portal
    spec:
      containers:
        - image: $CONTAINER_IMAGE
          name: pos-portal
          ports:
            - containerPort: 3000
              protocol: TCP
          resources: {}
      restartPolicy: Always
      imagePullSecrets:
        - name: regcred
